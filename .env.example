# Copiez ce fichier en `.env.local` pour le développement,
# et définissez les mêmes variables dans Vercel (Settings → Environment Variables).
# Ne commitez JAMAIS de vraies valeurs : `.env.local` est ignoré par git.

# ── Site ──
# URL publique du site, sans « / » final. Utilisée pour le SEO, le sitemap et Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.com

# ── Espace admin (ajout des réalisations depuis le site) ──
# Mot de passe de connexion sur /connexion. Choisissez-le long et unique.
ADMIN_PASSWORD=
# Secret qui signe le cookie de session : au moins 32 caractères aléatoires.
# Générez-le par exemple avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Services Vercel (ajoutés automatiquement par les intégrations, voir README) ──
# Base Postgres Neon (Vercel → Storage → Neon).
DATABASE_URL=
# Stockage d'images Vercel Blob (Vercel → Storage → Blob).
BLOB_READ_WRITE_TOKEN=
